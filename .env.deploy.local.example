# Copy this file to ".env.deploy.local" and fill in the values you want.
# The file is git-ignored. scripts\start-vygo.ps1 loads it into the process
# environment before starting the backend, so the backend inherits these vars.
#
# EVERYTHING HERE IS OPTIONAL. With none of it set, the app still runs: OTPs
# are shown in the response as a development code (dev profile only), and the
# face scan simply skips the automated face-match + liveness enforcement.

# --- core secrets (required in prod) ---------------------------------------
VYGO_JWT_SECRET=change-me
VYGO_QR_SECRET=change-me

# --- real email (free: Gmail SMTP) -----------------------------------------
# 1. Turn on 2-Step Verification on the Google account.
# 2. Create an "App password" (Google Account > Security > App passwords).
# 3. Use the 16-char app password below (spaces optional).
VYGO_EMAIL_ENABLED=true
VYGO_EMAIL_FROM=your.address@gmail.com
VYGO_MAIL_HOST=smtp.gmail.com
VYGO_MAIL_PORT=587
VYGO_MAIL_USERNAME=your.address@gmail.com
VYGO_MAIL_PASSWORD=xxxxxxxxxxxxxxxx
VYGO_MAIL_SMTP_AUTH=true
VYGO_MAIL_STARTTLS=true

# --- real SMS OTP (free trial: Text.lk / Notify.lk) ------------------------
# Leave disabled to fall back to the dev code. Provider: textlk | notifylk
VYGO_SMS_ENABLED=false
VYGO_SMS_PROVIDER=textlk
VYGO_SMS_API_KEY=
VYGO_SMS_SENDER_ID=VyGo
# Notify.lk also needs the account user id:
VYGO_SMS_USER_ID=

# --- self-hosted face match (free, on this machine) ------------------------
# Requires: install Python 3.12 + run face-service\run.cmd once (downloads
# DeepFace/TensorFlow ~1GB). Then set enabled=true and it starts automatically
# with start-vygo.ps1.
VYGO_FACE_ENABLED=false
VYGO_FACE_URL=http://localhost:8100
VYGO_FACE_MATCH_THRESHOLD=0.40
VYGO_FACE_REQUIRE_LIVENESS=true
